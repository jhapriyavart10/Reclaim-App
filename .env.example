# ==========================================
# RECLAIM - Autonomous Business Rescue Agent
# Environment Configuration
# ==========================================

# --- LLM Provider Configuration ---
# Provider Mode: auto | gemini | groq | mock
LLM_PROVIDER=auto

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# LLM Resilience
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=20.0

# --- Mission Policy ---
# Policy: STRICT_LIVE | HYBRID | SIMULATION
# STRICT_LIVE: Fails immediately if any primary connector is unconfigured/simulated
# HYBRID: Prefers live, uses simulation for supporting context, explicitly reports provenance
# SIMULATION: Uses deterministic simulated twins
MISSION_DATA_POLICY=HYBRID

# --- GitHub Live Connector ---
# Personal Access Token with 'repo' scope
GITHUB_TOKEN=
# Required test repository for safe write testing (e.g. owner/repo)
GITHUB_TEST_REPO=

# --- Slack Live Connector ---
# Slack Bot Token starting with xoxb- with 'channels:history', 'chat:write'
SLACK_BOT_TOKEN=
# Required test channel name or ID for safe write testing
SLACK_TEST_CHANNEL=

# --- Jira Live Connector ---
# Jira Cloud base URL (e.g. https://your-domain.atlassian.net)
JIRA_URL=
# Atlassian user email
JIRA_USER_EMAIL=
# Atlassian API token (from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=
# Required designated test project key (e.g. TEST or RECLAIM)
JIRA_TEST_PROJECT=
# Optional dedicated test issue key for non-destructive update tests
JIRA_TEST_ISSUE=
